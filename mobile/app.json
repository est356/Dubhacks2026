{
  "expo": {
    "name": "Catfe",
    "slug": "catfe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "catfe",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dubhacks.catfe",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Catfe uses photos when you log a study session."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F1E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.dubhacks.catfe",
      "permissions": ["READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Catfe to attach photos to study sessions."
        }
      ]
    ]
  }
}
